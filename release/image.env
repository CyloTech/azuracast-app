# Release metadata for this branch, read by release/build-on-builder.sh and
# release/verify-image.sh. Plain KEY=value lines only.
cylo_build_kind=official-php
cylo_build_repo_slug=azuracast-app
cylo_build_image=azuracast
cylo_build_tag=0.23.4-1
cylo_build_release_ref=repo.cylo.net/azuracast:0.23.4-1
cylo_build_dockerfile=Dockerfile
cylo_build_git_remote=origin
cylo_build_git_branch=php-multipart-fix
# The deployed image the release is built on.
gate_base_ref=repo.cylo.net/azuracast@sha256:b6eb3c765dc06eee2a430abf359090cc0cdba3551a229df95d016df63d45954f
# The PHP release that fixes the multipart/form-data bugs (21 October 2026).
gate_php_release_version=8.5.12
gate_php_image_pattern=repo.cylo.net/php-artifacts:docker-library-php-8.5.12-fpm-trixie
gate_php_extension_dir=/usr/local/lib/php/extensions/no-debug-non-zts-20250925
# Renders php-fpm.conf from its template, as the container does at start.
gate_fpm_prepare=/etc/my_init.d/06_php_conf.sh
# Renders the nginx configuration as the container does at start, before nginx -t.
gate_web_prepare=/release/web-prepare.sh
